{
  "name": "dsh-knowledge-base",
  "version": "0.1.0",
  "description": "我的知识库：上传跨境选品知识文档，Agent 先检索知识库再回答选品问题",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "knowledge-base",
    "cross-border",
    "ecommerce"
  ],
  "license": "MIT",
  "author": "qinshige",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qinshige/dsh-knowledge-base.git"
  },
  "homepage": "https://github.com/qinshige/dsh-knowledge-base#readme",
  "bugs": {
    "url": "https://github.com/qinshige/dsh-knowledge-base/issues"
  },
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "host",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "sample"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  }
}
